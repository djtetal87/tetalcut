// TetalCut's panels, as CapCut has them: a clip's movement (entrance, exit
// and movement on screen), auto colour and light over Adjust, and speed
// curves under Speed. They read and report through the Editor global, so
// the desktop inspector and the phone's sheets show the same panels.

import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Section, SectionBody, SectionHeader } from "../primitives/panel.slint";
import { Button, Modal } from "../primitives/modal.slint";
import { Glyph, Icon } from "../icons.slint";
import { Note, Switch } from "controls.slint";
import { CurveEditor } from "grading.slint";
import { CategoryPillBar } from "../workspace/media-pane.slint";
import { Editor } from "../editor.slint";

/// A labelled row of choices, scrolled sideways: one row of the movement panel.
component ChoiceRow inherits VerticalLayout {
    in property <string> label;
    in property <[string]> options;
    in property <int> current;
    callback picked(name: string);

    padding-left: Theme.pad;
    padding-right: Theme.pad;
    spacing: 4px;

    Text {
        text: root.label;
        color: Theme.fg-dim;
        font-size: Theme.fs-sm;
    }
    CategoryPillBar {
        categories: root.options;
        current: root.current < 0 ? "" : root.options[root.current];
        picked(name) => { root.picked(name); }
    }
}

/// Movement: how the clip comes in, goes out and moves while on screen.
export component MotionPanel inherits VerticalLayout {
    /// A title: offers to give every title the same movement.
    in property <bool> titles;
    in property <bool> first: true;

    Section {
        first: root.first;
        header := SectionHeader {
            title: I18n.t("motion.motion");
            collapsible: true;
        }

        if header.open: SectionBody {
            spacing: 10px;

            ChoiceRow {
                label: I18n.t("motion.entrance");
                options: Editor.motion-entrances;
                current: Editor.motion-entrance;
                picked(name) => { Editor.motion-pick(0, name); }
            }
            ChoiceRow {
                label: I18n.t("motion.exit");
                options: Editor.motion-exits;
                current: Editor.motion-exit;
                picked(name) => { Editor.motion-pick(1, name); }
            }
            ChoiceRow {
                label: I18n.t("motion.loop");
                options: Editor.motion-loops;
                current: Editor.motion-loop;
                picked(name) => { Editor.motion-pick(2, name); }
            }

            if root.titles: HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                Button {
                    block: true;
                    label: I18n.t("motion.applyToAllTitles");
                    clicked => { Editor.motion-apply-all(); }
                }
            }

            Note {
                text: I18n.t("motion.hint");
            }
        }
    }
}

/// Auto light and colour: the Adjust panel's knobs set from the picture.
export component AutoAdjustRow inherits VerticalLayout {
    padding-left: Theme.pad;
    padding-right: Theme.pad;
    padding-top: 10px;
    padding-bottom: 4px;
    spacing: 6px;

    HorizontalLayout {
        spacing: 6px;
        Button {
            horizontal-stretch: 1;
            label: I18n.t("adjust.autoLight");
            clicked => { Editor.adjust-auto(0); }
        }
        Button {
            horizontal-stretch: 1;
            label: I18n.t("adjust.autoColor");
            clicked => { Editor.adjust-auto(1); }
        }
    }
    Button {
        block: true;
        primary: true;
        label: I18n.t("adjust.autoBoth");
        clicked => { Editor.adjust-auto(2); }
    }
}

/// Speed curves: CapCut's ready-made ones, and the curve to draw.
export component SpeedCurvePanel inherits VerticalLayout {
    in property <bool> first: false;

    Section {
        first: root.first;
        header := SectionHeader {
            title: I18n.t("speedCurve.curve");
            collapsible: true;
        }

        if header.open: SectionBody {
            spacing: 10px;

            ChoiceRow {
                label: I18n.t("speedCurve.presets");
                options: Editor.speed-presets;
                current: Editor.speed-preset;
                picked(name) => { Editor.speed-preset-pick(name); }
            }

            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                CurveEditor {
                    curves: Editor.speed-curve;
                    point(key, index, x, y) => { Editor.speed-curve-point(index, x, y); }
                    remove(key, index) => { Editor.speed-curve-remove(index); }
                }
            }

            Note {
                text: I18n.t("speedCurve.hint");
            }
        }
    }
}

/// TetalCut: a small square icon button of the sound bank's rows.
component SmallIcon inherits Rectangle {
    in property <Glyph> glyph;
    in property <bool> danger;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: root.danger ? #e5484d : touch.has-hover ? Theme.field-hover : transparent;

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: 13px;
        tint: root.danger ? white : Theme.fg-dim;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// TetalCut: a round icon button of the sound bank's rows.
component RoundIcon inherits Rectangle {
    in property <Glyph> glyph;
    in property <bool> lit;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: root.lit ? Theme.accent : touch.has-hover ? Theme.field-hover : Theme.field;

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: 14px;
        tint: root.lit ? white : Theme.fg;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// TetalCut: a line to type in, answered on Enter or by its button.
component QueryField inherits HorizontalLayout {
    in property <string> placeholder;
    in property <string> action;
    in property <bool> secret;
    callback accepted(text: string);

    spacing: 6px;

    Rectangle {
        horizontal-stretch: 1;
        height: 34px;
        border-radius: Theme.r-sm;
        background: Theme.field;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.line;
        clip: true;

        input := TextInput {
            x: 8px;
            y: (parent.height - self.height) / 2;
            width: parent.width - 16px;
            color: Theme.fg;
            font-size: Theme.fs-lg;
            single-line: true;
            input-type: root.secret ? InputType.password : InputType.text;
            accepted => { root.accepted(self.text); }
        }
        if input.text == "" && !input.has-focus: Text {
            x: 8px;
            y: (parent.height - self.height) / 2;
            text: root.placeholder;
            color: Theme.fg-dim;
            font-size: Theme.fs-lg;
        }
    }
    Button {
        label: root.action;
        primary: true;
        clicked => { root.accepted(input.text); }
    }
}

/// TetalCut: the sound bank - music and effects by category; a tap hears
/// a sound, + puts it at the playhead.
export component SoundsDialog inherits Modal {
    open: Editor.sounds-shown;
    title: I18n.t("sounds.sounds");
    glyph: Glyph.music;
    surface-width: 520px;
    closed => { Editor.sounds-open(false); }

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        CategoryPillBar {
            categories: Editor.sound-categories;
            current: Editor.sound-category;
            picked(name) => { Editor.sound-category-pick(name); }
        }

        // Freesound: the key once, then the search
        if Editor.freesound-mode && !Editor.freesound-key-set: VerticalLayout {
            spacing: 6px;
            Text {
                text: I18n.t("sounds.keyHint");
                color: Theme.fg;
                font-size: Theme.fs;
                wrap: word-wrap;
            }
            QueryField {
                placeholder: I18n.t("sounds.keyPlaceholder");
                action: I18n.t("sounds.keySave");
                secret: true;
                accepted(text) => { Editor.freesound-key(text); }
            }
        }
        if Editor.freesound-mode && Editor.freesound-key-set: VerticalLayout {
            spacing: 6px;
            QueryField {
                placeholder: I18n.t("sounds.searchPlaceholder");
                action: I18n.t("sounds.search");
                accepted(text) => { Editor.freesound-search(text); }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: I18n.t("sounds.commercialOnly");
                    color: Theme.fg;
                    font-size: Theme.fs;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                Switch {
                    checked: Editor.freesound-commercial;
                    toggled(on) => { Editor.freesound-commercial-set(on); }
                }
            }
        }
        if Editor.freesound-mode && Editor.freesound-status != "": Text {
            text: Editor.freesound-status;
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        Flickable {
            min-height: 220px;
            preferred-height: 420px;
            vertical-stretch: 1;
            content-height: list.preferred-height;

            list := VerticalLayout {
                spacing: 4px;

                for sound in Editor.sounds: Rectangle {
                    height: sound.renaming ? 92px : 48px;
                    border-radius: Theme.r-xs;
                    background: sound.playing ? Theme.field-active : row-touch.has-hover ? Theme.field-hover : transparent;

                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Editor.sound-preview(sound.path); }
                    }

                    VerticalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;

                        HorizontalLayout {
                            height: 48px;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                RoundIcon {
                                    glyph: sound.playing ? Glyph.pause : Glyph.play;
                                    lit: sound.playing;
                                    clicked => { Editor.sound-preview(sound.path); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: sound.name;
                                    color: Theme.fg;
                                    font-size: Theme.fs-lg;
                                    overflow: elide;
                                }
                                Text {
                                    text: sound.loading ? I18n.t("sounds.loading") : sound.category;
                                    color: Theme.fg-dim;
                                    font-size: Theme.fs-sm;
                                    overflow: elide;
                                }
                            }
                            if sound.editable: VerticalLayout {
                                alignment: center;
                                SmallIcon {
                                    glyph: Glyph.text-mark;
                                    clicked => { Editor.sound-rename-begin(sound.renaming ? "" : sound.path); }
                                }
                            }
                            if sound.editable: VerticalLayout {
                                alignment: center;
                                SmallIcon {
                                    glyph: Glyph.trash;
                                    danger: sound.deleting;
                                    clicked => { Editor.sound-delete(sound.path); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                RoundIcon {
                                    glyph: Glyph.plus;
                                    clicked => { Editor.sound-add(sound.path); }
                                }
                            }
                        }
                        if sound.deleting: Text {
                            text: I18n.t("sounds.deleteAgain");
                            color: #e5484d;
                            font-size: Theme.fs-sm;
                        }
                        if sound.renaming: QueryField {
                            placeholder: sound.name;
                            action: I18n.t("sounds.rename");
                            accepted(text) => { Editor.sound-rename(sound.path, text); }
                        }
                    }
                }
            }
        }

        if Editor.sounds-note != "": Text {
            text: Editor.sounds-note;
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 6px;
            Button {
                horizontal-stretch: 1;
                glyph: Glyph.import;
                label: I18n.t("sounds.importMine");
                clicked => { Editor.sounds-import(); }
            }
            Button {
                horizontal-stretch: 1;
                glyph: Glyph.split;
                label: I18n.t("sounds.splitCompilation");
                clicked => { Editor.sounds-split(); }
            }
        }
        Text {
            text: I18n.t("sounds.folderHint");
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
    }
}
